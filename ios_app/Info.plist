    <string>APEX OS uses front-facing camera computer vision to track workout kinematics, validate squat depth, and count repetitions in real time.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>APEX OS analyzes acoustic vocal pitch and thoracic resonance.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
